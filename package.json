{
  "name": "kitchenasty",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup-dev.mjs",
    "db:up": "docker compose up -d postgres mailhog",
    "db:down": "docker compose stop postgres mailhog",
    "db:fix": "docker compose restart postgres && docker compose up -d postgres mailhog",
    "db:migrate": "npx -w packages/server prisma migrate deploy --schema ../../prisma/schema.prisma",
    "db:seed": "npx -w packages/server prisma db seed",
    "docker:full": "docker compose --profile full up -d --build",
    "docker:full:down": "docker compose --profile full down",
    "dev:server": "npm run dev -w packages/server",
    "dev:admin": "npm run dev -w packages/admin",
    "dev:storefront": "npm run dev -w packages/storefront",
    "dev:docs": "npm run dev -w packages/docs",
    "dev:mobile": "npm run start -w packages/mobile",
    "build": "npm run build -w packages/shared && npm run build -w packages/server && npm run build -w packages/admin && npm run build -w packages/storefront",
    "build:docs": "npm run build -w packages/docs",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test -w packages/shared && npm run test:unit -w packages/server",
    "test:integration": "npm run test:integration -w packages/server",
    "test:e2e": "npx playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "playwright": "^1.58.2",
    "prisma": "^5.22.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
