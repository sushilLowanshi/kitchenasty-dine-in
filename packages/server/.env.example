PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5176,http://localhost:5177
# Public storefront origin used for table-screen URLs. No trailing slash.
STOREFRONT_URL=http://localhost:5174
# Admin panel URL used in invite emails (no trailing slash)
ADMIN_URL=http://localhost:5173

# Docker Compose maps Postgres to host port 5433 (see docker-compose.yml).
# Use 127.0.0.1 (not localhost) so Windows/Node does not prefer IPv6 ::1.
DATABASE_URL=postgresql://kitchenasty:kitchenasty@127.0.0.1:5433/kitchenasty

JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# --- Email (local Mailhog by default) ---
# Start with: docker compose up -d mailhog  →  http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_ENCRYPTION=none
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=KitchenAsty <noreply@kitchenasty.com>

# Optional: real Gmail (App Password) — comment Mailhog block above and set these:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=KitchenAsty <you@gmail.com>

# Razorpay (optional for Pay Online)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_CURRENCY=INR
RAZORPAY_UPI_VPA=kitchenasty@razorpay
RAZORPAY_PAYEE_NAME=KitchenAsty

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
