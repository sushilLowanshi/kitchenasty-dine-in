PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Public storefront origin used for table-screen URLs. No trailing slash.
STOREFRONT_URL=http://localhost:5174

# If host 5432 is taken by local Windows PostgreSQL, use Docker mapped port 5433:
# DATABASE_URL=postgresql://kitchenasty:kitchenasty@localhost:5433/kitchenasty
DATABASE_URL=postgresql://kitchenasty:kitchenasty@localhost:5432/kitchenasty

JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# Admin panel URL used in invite emails (no trailing slash)
ADMIN_URL=http://localhost:5173

# --- Email (pick ONE) ---
# A) Local catcher (default) — docker compose up -d mailhog → http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_ENCRYPTION=none
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=KitchenAsty <noreply@kitchenasty.com>

# B) Real Gmail inbox — replace with your Gmail + App Password
#    Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=sushil.lowanshi@preciousinfosystem.com
SMTP_PASS=mveevqesclizeofr
EMAIL_FROM=KitchenAsty <sushil.lowanshi@preciousinfosystem.com>
Then restart the API server. Invite links still also show in the admin UI.

# Razorpay — REQUIRED for Pay Online (Standard Checkout screen)
# Test keys: https://dashboard.razorpay.com/app/keys (Test Mode ON)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_CURRENCY=INR
RAZORPAY_UPI_VPA=kitchenasty@razorpay
RAZORPAY_PAYEE_NAME=KitchenAsty
# RAZORPAY_DEMO_AUTO_MS=8000  # disabled

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
